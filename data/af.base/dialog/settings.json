{
  "type": "minecraft:multi_action",
  "title": "Furniture Settings",
  "body": {
    "type": "minecraft:item",
    "item": {
      "id": "minecraft:stick",
      "components": {
        "minecraft:tooltip_display": {
            "hide_tooltip": true
        },
        "minecraft:item_model": "minecraft:gui/settings_display"
      }
    },
    "height": 80
  },
  "inputs": [
    {
      "type": "minecraft:boolean",
      "key": "af2_setting0",
      "label": "Shulker Box Table Hitboxes",
      "initial": false
    },
    {
      "type": "minecraft:number_range",
      "key": "af2_setting1",
      "label": {
        "text": "Decorations Per 128 Blocks"
      },
      "start": 0,
      "end": 1024,
      "step": 8,
      "initial": 1024
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": "Confirm",
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "function af.base:option/apply_settings {0:$(af2_setting0),1:$(af2_setting1)}"
      }
    }
  ]
}